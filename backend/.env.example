# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://localhost:27015/investment_platform

# JWT Security
JWT_ACCESS_SECRET=your_jwt_access_secret_key_32_chars_long_minimum
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_32_chars_long_minimum
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Default Admin Credentials (Seeded on startup if database is empty)
DEFAULT_ADMIN_NAME=Platform Admin
DEFAULT_ADMIN_EMAIL=admin@investmentplatform.com
DEFAULT_ADMIN_PASSWORD=AdminSecurePassword123!

# Session & Security Settings
SESSION_SECRET=a_very_secure_random_session_secret_key
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false # Set to true in production with HTTPS
